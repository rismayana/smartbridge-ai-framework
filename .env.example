# SHMS — Environment Variables Template
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# JANGAN commit file .env ke Git (sudah ada di .gitignore)

# ── DagsHub / MLflow ───────────────────────────────────
# Dapatkan token di: https://dagshub.com/user/settings/tokens
DAGSHUB_TOKEN=GANTI_DENGAN_TOKEN_DAGSHUB_KAMU
